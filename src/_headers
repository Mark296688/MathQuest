# Kopfzeilen für die Spieldateien in der Online-Version (Cloudflare liest diese Datei, online/wrangler.jsonc).
# Der lokale Server (server/server.js) beachtet sie nicht. Der sha256-Wert gehört zum Importmap-Skript in index.html,
# tests/online.test.js prüft, dass er passt. style-src braucht 'unsafe-inline' für die style-Attribute im Spiel.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=15552000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-seCLxFfQToKeWoPJAMxxTkPU81nIj/JsvrOdN9OtJwI='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' data: blob:; font-src 'self'; media-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
